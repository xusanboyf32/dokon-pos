# Bu fayl — namuna. Nusxasini `.env` deb saqlang va qiymatlarni to'ldiring.
# `.env` GitHub'ga chiqmaydi, `.env.example` chiqadi (unda haqiqiy parol bo'lmaydi).

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# postgresql+asyncpg://FOYDALANUVCHI:PAROL@HOST:PORT/BAZA
DATABASE_URL=postgresql+asyncpg://dokon_user:PAROLNI_YOZING@localhost:5432/dokon_db

# Testlar uchun alohida baza (nomi albatta _test bilan tugashi shart)
TEST_DATABASE_URL=postgresql+asyncpg://dokon_user:PAROLNI_YOZING@localhost:5432/dokon_test

# Redis (login hisoblagichlari). Testlar avtomatik ravishda 15-bazadan foydalanadi.
REDIS_URL=redis://localhost:6379/0

# JWT imzosi uchun maxfiy kalit (kamida 32 belgi). Yaratish:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=BU_YERGA_YARATILGAN_KALITNI_QOYING

CORS_ORIGINS=["http://localhost:5173"]
